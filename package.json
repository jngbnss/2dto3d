{
  "name": "sixview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Single 2D image to six orthographic views: generation + consistency analysis for 3D reconstruction",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "sixview": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "cli": "node src/cli.ts",
    "demo": "node src/cli.ts demo --out out",
    "serve": "node src/cli.ts serve --dir out",
    "test": "node --test test/*.test.ts",
    "regression": "node tools/regression.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "cad:install": "npm --prefix cad install",
    "cad:build": "npm --prefix cad run build",
    "cad:dev": "npm --prefix cad run dev",
    "ai:setup": "node tools/hunyuan-local/setup.ts",
    "ai:local": "node tools/hunyuan-local/start.ts"
  },
  "dependencies": {
    "manifold-3d": "^3.5.4",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  }
}
